<UserControl x:Class="SortingLab4.App.Views.ExternalSortView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,4,4,12">
            <!-- Источник данных и настройки -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="1. Источник данных и параметры внешней сортировки" FontSize="15.5" FontWeight="Bold" />
                        <TextBlock x:Name="TxtFileMeta" Text="Файл не загружен" HorizontalAlignment="Right"
                                   FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                    </DockPanel>

                    <WrapPanel Margin="0,0,0,12">
                        <Button Content="Сценарий 1: Страны мира" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6" Click="LoadCountries_Click" />
                        <Button Content="Сценарий 2: Химические вещества" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6" Click="LoadChemicals_Click" />
                        <Button Content="Сценарий 3: Русские слова" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6" Click="LoadRussianWords_Click" />
                        <Button Content="Загрузить файл (CSV / TXT)" Style="{StaticResource PrimaryButton}" Margin="0,0,8,6" Click="UploadFile_Click" />
                    </WrapPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="0.8*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Метод сортировки:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ComboBox x:Name="CmbMethod" SelectedIndex="0" SelectionChanged="CmbMethod_SelectionChanged">
                                <ComboBoxItem Content="Прямое слияние" Tag="Direct" />
                                <ComboBoxItem Content="Естественное слияние" Tag="Natural" />
                                <ComboBoxItem Content="Многопутевое слияние" Tag="Multiway" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2" x:Name="WaysPanel" Visibility="Collapsed">
                            <TextBlock Text="Файлов (k):" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ComboBox x:Name="CmbWays" SelectedIndex="0" Width="76">
                                <ComboBoxItem Content="3" />
                                <ComboBoxItem Content="4" />
                                <ComboBoxItem Content="5" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Ключевой столбец:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ComboBox x:Name="CmbKeyCol" />
                        </StackPanel>

                        <StackPanel Grid.Column="6">
                            <TextBlock Text="Тип ключа:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ComboBox x:Name="CmbKeyType" SelectedIndex="0">
                                <ComboBoxItem Content="Авто" Tag="Auto" />
                                <ComboBoxItem Content="Числовой" Tag="Number" />
                                <ComboBoxItem Content="Текстовый" Tag="Text" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="8">
                            <TextBlock Text="Фильтр по столбцу:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ComboBox x:Name="CmbFilterCol" SelectionChanged="CmbFilterCol_SelectionChanged" />
                        </StackPanel>

                        <StackPanel Grid.Column="10">
                            <TextBlock Text="Значение фильтра:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ComboBox x:Name="CmbFilterVal" IsEnabled="False" />
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,12" Background="{StaticResource BorderBrushLight}" />

                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Button x:Name="BtnStart" Content="Запустить" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="Start_Click" />
                            <Button x:Name="BtnPause" Content="Пауза" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" IsEnabled="False" Click="Pause_Click" />
                            <Button x:Name="BtnResume" Content="Продолжить" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" IsEnabled="False" Click="Resume_Click" />
                            <Button x:Name="BtnStep" Content="Следующий шаг" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" IsEnabled="False" Click="NextStep_Click" />
                            <Button x:Name="BtnReset" Content="Сброс" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Reset_Click" />
                            <Button x:Name="BtnOpenFile" Content="Открыть результат" Style="{StaticResource SuccessButton}" Margin="0,0,8,0" Visibility="Collapsed" Click="OpenResult_Click" />
                            <Button x:Name="BtnSaveAs" Content="Сохранить как..." Style="{StaticResource SecondaryButton}" Visibility="Collapsed" Click="SaveAs_Click" />
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="Задержка: " FontSize="12.5" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtSpeedVal" Text="550 мс" FontWeight="Bold" Width="56" VerticalAlignment="Center" />
                            <Slider x:Name="SldSpeed" Width="130" Minimum="100" Maximum="1800" Value="550" TickFrequency="50" IsSnapToTickEnabled="True"
                                    ValueChanged="SldSpeed_ValueChanged" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>

                    <Border x:Name="ErrBanner" Visibility="Collapsed" Background="#FEE2E2" BorderBrush="#FECACA" BorderThickness="1"
                            CornerRadius="7" Padding="10,7" Margin="0,10,0,0">
                        <TextBlock x:Name="TxtError" Foreground="#991B1B" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Border>
                    <Border x:Name="SavedBanner" Visibility="Collapsed" Background="#DCFCE7" BorderBrush="#BBF7D0" BorderThickness="1"
                            CornerRadius="7" Padding="10,7" Margin="0,10,0,0">
                        <TextBlock x:Name="TxtSavedInfo" Foreground="#166534" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- Пояснение шага -->
            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="14,11" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <Border Background="#DBEAFE" CornerRadius="10" Padding="9,2" DockPanel.Dock="Left">
                            <TextBlock x:Name="TxtStepBadge" Text="Ожидание" FontSize="12" FontWeight="Bold" Foreground="#1D4ED8" />
                        </Border>
                        <TextBlock x:Name="TxtStepCounter" Text="Шаг 0 / 0" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock x:Name="TxtExplanation" TextWrapping="Wrap" FontSize="14.5"
                               Text="Выберите сценарий или загрузите файл, затем нажмите «Запустить» или «Следующий шаг»." />
                </StackPanel>
            </Border>

            <!-- Файлы на диске + Журнал -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.65*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="Состояние файлов на диске (серии и слияние)" FontSize="15" FontWeight="Bold" />
                            <TextBlock x:Name="TxtStats" Text="Проходов: 0  |  Сравнений: 0  |  Перемещений: 0"
                                       HorizontalAlignment="Right" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                        </DockPanel>
                        <StackPanel x:Name="FilesVizPanel">
                            <TextBlock Text="Здесь отобразятся основной и вспомогательные файлы во время сортировки."
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,12" HorizontalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Журнал внешней сортировки" FontSize="15" FontWeight="Bold" Margin="0,0,0,10" />
                        <ListBox x:Name="LstLog" MaxHeight="340" BorderBrush="#E5E9F0" Background="#FAFBFD"
                                 Padding="4" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,5" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="#E5E9F0" BorderThickness="1" CornerRadius="6" Padding="9,6">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,2">
                                                <TextBlock Text="{Binding StepHeader}" FontSize="11.5" FontWeight="SemiBold" Foreground="#64748B" />
                                                <TextBlock Text="{Binding TypeLabel}" FontSize="11.5" FontWeight="SemiBold" Foreground="#2563EB" HorizontalAlignment="Right" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" FontSize="12.5" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Таблицы: Исходная и Отсортированная -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="Исходная таблица" FontSize="15" FontWeight="Bold" />
                            <TextBlock x:Name="TxtSrcCount" Text="0 записей" HorizontalAlignment="Right" Foreground="{StaticResource TextMutedBrush}" />
                        </DockPanel>
                        <DataGrid x:Name="GridSource" MaxHeight="280" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="Отсортированная таблица" FontSize="15" FontWeight="Bold" />
                            <TextBlock x:Name="TxtResCount" Text="0 записей" HorizontalAlignment="Right" Foreground="{StaticResource TextMutedBrush}" />
                        </DockPanel>
                        <DataGrid x:Name="GridResult" MaxHeight="280" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
