<UserControl x:Class="SortingLab4.App.Views.InternalSortView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Верхняя компактная панель управления -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,10" Padding="12,10">
            <StackPanel>
                <!-- Строка 1: Алгоритм + ввод/генерация массива -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Сегментированный переключатель алгоритмов -->
                    <Border Grid.Column="0" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="7" Padding="3">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="RbBubble" GroupName="InternalAlgo" IsChecked="True"
                                         Content="Bubble" ToolTip="Группа 1 (квадратичные): сортировка пузырьком"
                                         Style="{StaticResource SegmentRadio}" Checked="AlgoRadio_Checked" />
                            <RadioButton x:Name="RbInsertion" GroupName="InternalAlgo"
                                         Content="Insertion" ToolTip="Группа 1 (квадратичные): сортировка вставками"
                                         Style="{StaticResource SegmentRadio}" Checked="AlgoRadio_Checked" />
                            <Border Width="1" Background="#CBD5E1" Margin="4,5" />
                            <RadioButton x:Name="RbMerge" GroupName="InternalAlgo"
                                         Content="Merge" ToolTip="Группа 2 (усовершенствованные): сортировка слиянием"
                                         Style="{StaticResource SegmentRadio}" Checked="AlgoRadio_Checked" />
                            <RadioButton x:Name="RbQuick" GroupName="InternalAlgo"
                                         Content="Quick (Хоара)" ToolTip="Группа 2 (усовершенствованные): быстрая сортировка Хоара"
                                         Style="{StaticResource SegmentRadio}" Checked="AlgoRadio_Checked" />
                        </StackPanel>
                    </Border>

                    <!-- Ввод своего массива -->
                    <DockPanel Grid.Column="2" VerticalAlignment="Center">
                        <Button DockPanel.Dock="Right" Content="Применить" Style="{StaticResource SecondaryButton}"
                                Margin="6,0,0,0" Click="ApplyArray_Click" />
                        <TextBox x:Name="TxtArrayInput" Text="8, 3, -2, 11, 5, 3, 1, 9"
                                 ToolTip="Введите числа через запятую или пробел" />
                    </DockPanel>

                    <!-- Генератор случайного массива -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="N:" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock x:Name="TxtSizeVal" Text="10" FontSize="12.5" FontWeight="Bold" Width="20" VerticalAlignment="Center" />
                        <Slider x:Name="SldSize" Width="85" Minimum="4" Maximum="20" Value="10"
                                IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                                ValueChanged="SldSize_ValueChanged" Margin="2,0,8,0" />
                        <CheckBox x:Name="ChkNegative" Content="±" ToolTip="Включать отрицательные числа"
                                  IsChecked="True" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button Content="Случайный" Style="{StaticResource SecondaryButton}" Click="RandomArray_Click" />
                    </StackPanel>
                </Grid>

                <Border Height="1" Background="#ECEFF3" Margin="0,9" />

                <!-- Строка 2: Кнопки воспроизведения + скорость + статистика -->
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Button x:Name="BtnStart" Content="Запуск" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" Click="Start_Click" />
                        <Button x:Name="BtnPause" Content="Пауза" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" IsEnabled="False" Click="Pause_Click" />
                        <Button x:Name="BtnResume" Content="Продолжить" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" IsEnabled="False" Click="Resume_Click" />
                        <Button x:Name="BtnStep" Content="Следующий шаг" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="NextStep_Click" />
                        <Button x:Name="BtnReset" Content="Сброс" Style="{StaticResource SecondaryButton}" Click="Reset_Click" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock x:Name="TxtStats" Text="Сравнений: 0  |  Перестановок: 0"
                                   FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,18,0" />
                        <TextBlock Text="Задержка:" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBlock x:Name="TxtSpeedVal" Text="450 мс" FontSize="12.5" FontWeight="SemiBold" Width="48" VerticalAlignment="Center" />
                        <Slider x:Name="SldSpeed" Width="120" Minimum="100" Maximum="1400" Value="450"
                                TickFrequency="50" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                ValueChanged="SldSpeed_ValueChanged" />
                    </StackPanel>
                </DockPanel>

                <Border x:Name="ErrBanner" Visibility="Collapsed" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                        CornerRadius="6" Padding="10,6" Margin="0,8,0,0">
                    <TextBlock x:Name="TxtError" Foreground="#991B1B" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Полоса объяснения текущего шага -->
        <Border Grid.Row="1" Background="#F0F6FF" BorderBrush="#C7DDFC" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,10">
            <DockPanel>
                <Border x:Name="BadgeStepBorder" DockPanel.Dock="Left" Background="#DBEAFE" CornerRadius="5"
                        Padding="9,3" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtStepBadge" Text="Готово" FontSize="12" FontWeight="SemiBold" Foreground="#1D4ED8" />
                </Border>
                <TextBlock x:Name="TxtStepCounter" DockPanel.Dock="Right" Text="Шаг 0 / 0" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
                <TextBlock x:Name="TxtExplanation" TextWrapping="Wrap" FontSize="13.5" VerticalAlignment="Center"
                           Text="Выберите алгоритм и нажмите «Запуск» или «Следующий шаг»." />
            </DockPanel>
        </Border>

        <!-- Основная рабочая область (занимает всю оставшуюся высоту экрана) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.85*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1*" MinWidth="290" />
            </Grid.ColumnDefinitions>

            <!-- Визуализация -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Заголовок и контекст -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock x:Name="TxtVizTitle" Text="Bubble Sort (Сортировка пузырьком)" FontSize="14.5" FontWeight="Bold" />
                        <TextBlock x:Name="TxtAuxInfo" HorizontalAlignment="Right" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="#2563EB" VerticalAlignment="Center" />
                    </DockPanel>

                    <!-- Легенда цветов -->
                    <WrapPanel Grid.Row="1" x:Name="LegendPanel" Margin="0,0,0,8" />

                    <!-- Сцена визуализации -->
                    <Border Grid.Row="2" Background="#FAFBFD" BorderBrush="#E5E9F0" BorderThickness="1" CornerRadius="7" Padding="10">
                        <Grid>
                            <!-- Постоянный Canvas для плавных анимаций столбцов (Bubble / Insertion / Quick) -->
                            <Canvas x:Name="BarsCanvas" ClipToBounds="False" SizeChanged="BarsCanvas_SizeChanged" />

                            <!-- Дерево разделения и слияния для Merge Sort -->
                            <ScrollViewer x:Name="MergeScroll" Visibility="Collapsed"
                                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <Grid x:Name="MergeStage" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4" />
                            </ScrollViewer>

                            <TextBlock x:Name="TxtEmptyStage" Visibility="Collapsed" Text="Массив пустой."
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#64748B" FontSize="13.5" />
                        </Grid>
                    </Border>

                    <!-- Текущий и итоговый массив -->
                    <StackPanel Grid.Row="3" Margin="0,10,0,0">
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Текущий:" Width="74" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                            <WrapPanel x:Name="CurrentArrayPanel" />
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Text="Итоговый:" Width="74" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                            <WrapPanel x:Name="FinalArrayPanel">
                                <TextBlock Text="после завершения сортировки" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" />
                            </WrapPanel>
                        </DockPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Журнал операций -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Журнал операций" FontSize="14.5" FontWeight="Bold" />
                        <TextBlock x:Name="TxtLogAlgo" Text="Bubble Sort" HorizontalAlignment="Right"
                                   FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                    </DockPanel>

                    <ListBox Grid.Row="1" x:Name="LstLog" BorderBrush="#E5E9F0" Background="#FAFBFD"
                             Padding="4" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,5" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" BorderBrush="#E5E9F0" BorderThickness="1" CornerRadius="6" Padding="9,6">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,2">
                                            <TextBlock Text="{Binding StepHeader}" FontSize="11.5" FontWeight="SemiBold" Foreground="#64748B" />
                                            <TextBlock Text="{Binding TypeLabel}" FontSize="11.5" FontWeight="SemiBold" Foreground="#2563EB" HorizontalAlignment="Right" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" FontSize="12.5" Foreground="#18181B" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
