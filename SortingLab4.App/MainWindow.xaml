<Window x:Class="SortingLab4.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SortingLab4.App.Views"
        Title="Лабораторная работа №4. Алгоритмы сортировки"
        Width="1320" Height="820" MinWidth="1040" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Background="{StaticResource BgBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Строгая верхняя полоса навигации без лишних бейджей -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="18,0">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="Алгоритмы сортировки" FontSize="15.5" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,28,0" />

                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Stretch">
                    <RadioButton x:Name="NavInternal" GroupName="MainNav" IsChecked="True"
                                 Content="1. Внутренняя сортировка" Style="{StaticResource NavTabRadio}"
                                 Checked="NavTab_Checked" />
                    <RadioButton x:Name="NavExternal" GroupName="MainNav"
                                 Content="2. Внешняя сортировка" Style="{StaticResource NavTabRadio}"
                                 Checked="NavTab_Checked" />
                    <RadioButton x:Name="NavLex" GroupName="MainNav"
                                 Content="3. Лексикографическая сортировка" Style="{StaticResource NavTabRadio}"
                                 Checked="NavTab_Checked" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Контейнер разделов -->
        <Grid Grid.Row="1" Margin="14,12,14,12">
            <views:InternalSortView x:Name="ViewInternal" Visibility="Visible" />
            <views:ExternalSortView x:Name="ViewExternal" Visibility="Collapsed" />
            <views:LexicographicSortView x:Name="ViewLexicographic" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
